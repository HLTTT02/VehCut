# Copy this file to .env before running Docker Compose.
POSTGRES_DB=vehcut
POSTGRES_USER=vehcut
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://vehcut:change-this-local-password@postgres:5432/vehcut
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
STORAGE_ROOT=/data/vehcut
STORAGE_PUBLIC_BASE_URL=/storage
YOLO_MODEL_PATH=/models/yolo26s.pt
YOLO_DEVICE=cpu
YOLO_CONFIDENCE_THRESHOLD=0.5
YOLO_IMAGE_SIZE=640
PROCESSING_FRAME_STRIDE=1
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=1800
CELERY_TASK_TIME_LIMIT_SECONDS=1860
CELERY_TASK_MAX_RETRIES=1
